# plan-bot configuration for Termux. Copy to ~/.config/plan-bot/env, fill in the
# token and `chmod 600` the copy. Lines starting with # are comments.

# --- required (at least one) -------------------------------------------------
# Discord (the public demo runs here): Developer Portal -> Bot -> Reset Token.
# Never commit the filled-in copy. Needs the "discord" extra (install.sh adds it).
DISCORD_BOT_TOKEN=
# Testing only: sync the slash commands to this one server so they appear instantly.
# Leave empty in production (global commands take up to an hour to appear).
DISCORD_DEV_GUILD_ID=
# Optional second platform: token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# --- storage -----------------------------------------------------------------
# SQLite is the default and needs nothing else. 3 slashes + absolute path = 4 total.
DATABASE_URL=sqlite+aiosqlite:////data/data/com.termux/files/home/plan-bot/data/plan-bot.db
# PostgreSQL alternative (its own database and role; needs `pip install asyncpg`):
# DATABASE_URL=postgresql+asyncpg://planbot:CHANGE_ME@127.0.0.1:5432/planbot

# --- behaviour ---------------------------------------------------------------
PLAN_BOT_TIMEZONE=Europe/Warsaw
PLAN_BOT_REFRESH_MINUTES=30
# Identical feed links requested within this many seconds share one download.
PLAN_BOT_FETCH_CACHE_SECONDS=120
# Per chat: a burst of N commands, then this many per minute (feed downloads cost 4).
PLAN_BOT_RATE_BURST=10
PLAN_BOT_RATE_PER_MINUTE=30
PLAN_BOT_HEAVY_INTERVAL=45

# --- operations --------------------------------------------------------------
PLAN_BOT_LOG_LEVEL=INFO
# "json" prints one JSON object per line.
PLAN_BOT_LOG_FORMAT=text
# Health endpoint: GET http://127.0.0.1:8091/plan-bot/healthz (0 disables it).
PLAN_BOT_HEALTH_HOST=127.0.0.1
PLAN_BOT_HEALTH_PORT=8091
PLAN_BOT_BASE_PATH=/plan-bot
