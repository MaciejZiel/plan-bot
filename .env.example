# Copy to .env and fill in. Never commit the real .env file.

# Telegram: create a bot with @BotFather and paste its token here (leave empty to disable).
TELEGRAM_BOT_TOKEN=
# Discord: Developer Portal -> your application -> Bot -> Reset Token (leave empty to disable).
DISCORD_BOT_TOKEN=
# Optional: a Discord server (guild) ID for instant slash-command registration while testing.
DISCORD_GUILD_ID=

# SQLite by default; for PostgreSQL install the "postgres" extra and use
# postgresql+asyncpg://user:password@host:5432/planbot
DATABASE_URL=sqlite+aiosqlite:///./data/plan-bot.db

PLAN_BOT_TIMEZONE=Europe/Warsaw
PLAN_BOT_REFRESH_MINUTES=30
PLAN_BOT_TICK_SECONDS=30
PLAN_BOT_HORIZON_DAYS=150
PLAN_BOT_CHANGE_HORIZON_DAYS=28
# Weekly summary: weekday 0=Monday ... 6=Sunday, hour in local time
PLAN_BOT_SUMMARY_WEEKDAY=6
PLAN_BOT_SUMMARY_HOUR=18
PLAN_BOT_MAX_ICS_BYTES=5000000
PLAN_BOT_HTTP_TIMEOUT=20
# Only for self-hosted feeds on your own network; keep false on a public bot.
PLAN_BOT_ALLOW_PRIVATE_URLS=false
PLAN_BOT_LOG_LEVEL=INFO

# Added in 0.2 (see deploy/termux/env.example for the documented defaults)
TELEGRAM_API_URL=
PLAN_BOT_FETCH_CACHE_SECONDS=120
PLAN_BOT_RATE_BURST=10
PLAN_BOT_RATE_PER_MINUTE=30
PLAN_BOT_LOG_FORMAT=text
PLAN_BOT_HEALTH_HOST=127.0.0.1
PLAN_BOT_HEALTH_PORT=0
PLAN_BOT_BASE_PATH=
